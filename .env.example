# Browser-safe Supabase configuration used by the Vite application.
# Copy this file to .env.local and replace the placeholder values.
# Never expose SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY through VITE_*.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
